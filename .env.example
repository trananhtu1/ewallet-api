# Copy file này thành .env rồi điền giá trị thật từ Neon.
# File .example ĐƯỢC commit - nó là tài liệu cho biết project cần biến gì.
# File .env KHÔNG commit.
#
# Lấy ở Neon: Dashboard -> project -> Connection string.
# Neon đưa định dạng libpq:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Chuyển sang JDBC cho Java:
#   - thêm tiền tố "jdbc:"
#   - tách USER và PASSWORD ra khỏi URL thành 2 biến riêng
#   - giữ ?sslmode=require

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Khoa ky JWT. HS256 doi it nhat 256 bit = 32 KY TU, ngan hon la app chet luc khoi dong.
# Sinh khoa:  openssl rand -base64 48
# KHONG dung lai khoa nay o production - moi moi truong mot khoa rieng.
JWT_SECRET=doi-chuoi-nay-thanh-khoa-that-dai-it-nhat-32-ky-tu

# ===== Cache (tuy chon) =====
# De trong thi app chay khong cache - dung, chi cham hon.
# Tren Render KHONG can dat hai bien nay: render.yaml da khai bao Key Value instance va
# tu dien REDIS_URL vao. Day chi danh cho may ca nhan co Redis chay san.
#CACHE_TYPE=redis
#REDIS_URL=redis://localhost:6379

# ===== Kho ảnh / avatar (tuỳ chọn) =====
# ĐỂ TRỐNG thì app vẫn chạy bình thường, chỉ là ĐỔI ẢNH ĐẠI DIỆN SẼ TRẢ VỀ
# 503 STORAGE_DISABLED. Đó là cố ý: một tính năng phụ không được quyền làm cả
# hệ thống không khởi động được (xem ObjectStorage.java).
#
# ⚠️ Nên nếu upload avatar "không lên" ở máy mình mà backend không có lỗi gì,
# thì chỗ đầu tiên phải nhìn là bốn dòng dưới đây - chứ không phải frontend.
#
# Chạy được với BẤT KỲ kho nào nói giao thức S3, chỉ khác đúng dòng endpoint:
#   Supabase   https://<project-ref>.supabase.co/storage/v1/s3
#   Cloudflare https://<account-id>.r2.cloudflarestorage.com
#   MinIO      http://localhost:9000
#
# STORAGE_PUBLIC_URL là nơi ĐỌC (công khai, không ký), khác endpoint là nơi GHI.
# Nó phải trỏ THẲNG VÀO TRONG bucket - khoá file không chứa tên bucket:
#   https://<project-ref>.supabase.co/storage/v1/object/public/avatars
#
# Trên Render KHÔNG cần đặt tay: render.yaml đã khai sẵn các biến này.
#STORAGE_ENABLED=true
#STORAGE_ENDPOINT=
#STORAGE_PUBLIC_URL=
#STORAGE_ACCESS_KEY=
#STORAGE_SECRET_KEY=
#STORAGE_BUCKET=avatars
#STORAGE_REGION=auto
