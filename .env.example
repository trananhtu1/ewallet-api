# Copy file này thành .env rồi điền giá trị thật từ Neon.
# File .example ĐƯỢC commit - nó là tài liệu cho biết project cần biến gì.
# File .env KHÔNG commit.
#
# Lấy ở Neon: Dashboard -> project -> Connection string.
# Neon đưa định dạng libpq:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Chuyển sang JDBC cho Java:
#   - thêm tiền tố "jdbc:"
#   - tách USER và PASSWORD ra khỏi URL thành 2 biến riêng
#   - giữ ?sslmode=require

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
