<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>
	<groupId>com.vidien</groupId>
	<artifactId>ewallet-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ewallet-api</name>
	<description>Vi dien tu - REST API</description>

	<properties>
		<java.version>17</java.version>
		<mapstruct.version>1.6.3</mapstruct.version>
	</properties>

	<!--
	  spring-boot-dependencies KHONG quan version cua Testcontainers, nen phai nhap BOM rieng.
	  Nhap BOM chu khong go version vao tung dependency: mot cho khai bao, va cac artifact cua
	  Testcontainers luon khop version nhau - lech version giua chung la mot loai loi rat kho
	  doc vi no vo o luc chay chu khong luc bien dich.

	  Cung bai hoc voi luc chon thu vien JWT hom 27/08: uu tien thu co BOM quan, de nang mot
	  cai la ca ho di theo.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>2.0.5</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- JPA/Hibernate. Ghi chu cu o day noi "de Week 3 hay lam, gio no keo them ~10 jar
		     va mot dong magic chua can giai thich" - dung o thoi diem do, va gio thi nguoc lai:
		     JD ghi ro JPA/Hibernate, va muc tieu cua project la QUEN hinh dang code doanh
		     nghiep truoc khi va vao no that.

		     Keo theo luon spring-boot-starter-jdbc, nen KHONG khai bao lai: JdbcClient van
		     dung duoc, va no van la duong cho nhung cau SQL ma JPA khong dien dat noi -
		     cu the la muc khoa FOR NO KEY UPDATE o WalletRepository. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Bo @Getter/@Builder/@RequiredArgsConstructor viet tay. Chi tac dong luc BIEN DICH
		     (provided), khong di theo vao file jar chay that. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Doi entity <-> DTO. Sinh code luc BIEN DICH chu khong dung reflection luc chay,
		     nen go sai ten truong thi VO NGAY o buoc build - khac han cac thu vien mapper
		     dua tren reflection, chung im lang tra ve null. -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>
		<!-- Flyway: bảng sinh ra từ file trong repo, không phải gõ tay trên Neon console.
                     Chạy lúc khởi động, TRƯỚC khi Tomcat mở cổng. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- Spring Security: BCrypt de bam mat khau, va bo loc dung truoc moi request.
		     LUU Y: chi can co dependency nay tren classpath la Spring KHOA HET moi endpoint
		     va in ra mot mat khau ngau nhien luc khoi dong. Phai co SecurityConfig moi chay
		     tiep duoc - xem com/vidien/ewallet/config/SecurityConfig.java -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Keo theo Nimbus: JwtEncoder de PHAT token, JwtDecoder de KIEM token.
		     Khong dung jjwt vi spring-boot-dependencies khong quan version cua no,
		     con cai nay thi co - bot mot chuoi so phai tu theo doi. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  OpenAPI / Swagger UI.

		  springdoc 3.x chu khong phai 2.x: 2.x built cho Spring Boot 3 va dung
		  javax/jakarta + Spring Framework 6. Boot 4 doi Spring Framework len 7, nen 2.9.0
		  khoi dong duoc nhung /v3/api-docs tra 500 - mot kieu hong kho doan hon han la khong
		  bien dich duoc.

		  📌 Cung ho voi bay Testcontainers 1.21.3 vs Docker 29 sang nay va Jackson 2 vs
		  Jackson 3 chieu nay: THU VIEN CU CHAY DUOC voi ha tang moi, chi la sai. Doc so
		  phien ban truoc khi doc huong dan.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!--
		  Cache: hai starter chu khong mot.

		  spring-boot-starter-cache mang ABSTRACTION (@Cacheable, @CacheEvict, CacheManager).
		  Mot minh no thi Spring dung ConcurrentHashMap trong RAM - chay duoc, nhung moi
		  instance mot ban sao rieng, va Render co the chay nhieu instance.

		  spring-boot-starter-data-redis mang CAI CHUA THAT. Doi hai instance dung chung mot
		  cho nho, va cache song qua lan restart.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Testcontainers: dung mot Postgres THAT trong Docker cho tung lan chay test.
		     Khong dung H2 - va day khong phai so thich:

		     H2 khong co FOR NO KEY UPDATE, khong co JSONB, khong co UNION ALL voi LIMIT trong
		     nhanh con, va khong tai hien duoc deadlock. Tuc la no khong chay duoc dung nhung
		     thu can canh giu nhat. Test tren mot database KHAC voi production la test mot he
		     thong khac. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Lombok chi can luc bien dich. Khong loai ra thi no nam trong jar
					     chay that ma khong ai dung toi. -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- ⚠️ THU TU annotation processor QUAN TRONG, va sai thu tu la mot loi rat kho
			     doan: Lombok phai chay TRUOC MapStruct.

			     MapStruct sinh code mapper bang cach doc getter/setter cua entity. Neu no
			     chay truoc Lombok thi luc do entity CHUA CO getter nao - va thong bao loi
			     se la "Unknown property in result type" chu khong phai "thieu Lombok",
			     tro vao dung cai truong minh vua khai bao. -->
			<!--
			  ⚠️ Thieu plugin nay thi cac lop *IT KHONG BAO GIO CHAY, va build van xanh.

			  Surefire (chay o `mvn test`) chi nhan *Test, Test*, *Tests, *TestCase. Cac lop
			  ket thuc bang *IT thuoc ve Failsafe va chi chay o `mvn verify`. Do la quy uoc
			  chuan cua Maven, va ly do co that: unit test phai chay trong vai giay o moi lan
			  build, con integration test can Docker va mat lau hon nhieu - tron chung thi
			  hoac vong lap phat trien cham lai, hoac nguoi ta bat dau bo qua test.

			  📌 Va day dung la loai loi im lang da gap bon lan trong project: khai bao mot thu
			  ma thieu cai kich hoat no. Viet 4 integration test rat ky, chay `mvn test`, thay
			  BUILD SUCCESS - va khong mot dong nao trong so do tung duoc thuc thi.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<!-- verify PHAI co: thieu no thi test do van khong lam do build. -->
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
						<!-- Cho MapStruct doc duoc @Builder cua Lombok. Thieu no thi mapper
						     sinh ra van bien dich duoc nhung goi constructor thay vi builder. -->
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>0.2.0</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<!-- Ten tham so giu lai trong file class. Spring dung no de biet
						     @PathVariable long id ten la "id" ma khong phai khai bao lai. -->
						<arg>-parameters</arg>
						<!-- Mapper la @Component cua Spring, khong phai Mappers.getMapper(). -->
						<arg>-Amapstruct.defaultComponentModel=spring</arg>
						<!-- Quen map mot truong -> VO LUC BUILD, khong phai im lang tra null.
						     Day la ca diem chon MapStruct thay vi mot mapper reflection. -->
						<arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
					</compilerArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
