<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>
	<groupId>com.vidien</groupId>
	<artifactId>ewallet-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ewallet-api</name>
	<description>Vi dien tu - REST API</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Tuan nay chi can chung minh noi duoc toi Neon. JPA/Hibernate de Week 3
		     luc dung bang that: no keo them ~10 jar va mot dong "magic" chua can giai thich. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!-- Flyway: bảng sinh ra từ file trong repo, không phải gõ tay trên Neon console.
                     Chạy lúc khởi động, TRƯỚC khi Tomcat mở cổng. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- Spring Security: BCrypt de bam mat khau, va bo loc dung truoc moi request.
		     LUU Y: chi can co dependency nay tren classpath la Spring KHOA HET moi endpoint
		     va in ra mot mat khau ngau nhien luc khoi dong. Phai co SecurityConfig moi chay
		     tiep duoc - xem com/vidien/ewallet/config/SecurityConfig.java -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Keo theo Nimbus: JwtEncoder de PHAT token, JwtDecoder de KIEM token.
		     Khong dung jjwt vi spring-boot-dependencies khong quan version cua no,
		     con cai nay thi co - bot mot chuoi so phai tu theo doi. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
